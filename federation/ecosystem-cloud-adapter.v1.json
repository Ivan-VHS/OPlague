{
  "schema": "ivan-vhs.ecosystem-cloud-adapter.v1",
  "version": 1,
  "project": "oplague",
  "project_key": "oplague",
  "shared_contract": "ivan-vhs.ecosystem-cloud.v1",
  "shared_contract_version": 1,
  "status": "contract-only",
  "runtime": {
    "default_network_mode": "disabled",
    "user_opt_in_required": true,
    "core_requires_network": false,
    "supabase_transport": "not-implemented",
    "secret_source": "external-secret-store-only"
  },
  "publish_allowlist": [
    "sanitized-report-metadata",
    "artifact-sha256-hashes",
    "normalized-compatibility-summary",
    "user-selected-review-notes"
  ],
  "denylist": [
    "driver-binaries",
    "inf-payloads",
    "raw-device-identifiers",
    "serial-numbers",
    "raw-usb-descriptors",
    "private-signing-material",
    "access-tokens",
    "service-role-keys",
    "unredacted-local-paths",
    "raw-device-inventory"
  ],
  "security": {
    "inspection_mode": "read-only-local-first",
    "hash_semantics": "integrity-reference-only-not-authorship-proof",
    "payload_execution": "never",
    "automatic_upload": false
  },
  "synchronization": {
    "local_source_of_truth": true,
    "upload_requires_user_action": true,
    "retry": "bounded-idempotent",
    "idempotency": "actor_id+client_instance_id+event_id",
    "conflicts": "evidence-report-versioned"
  },
  "compatibility": {
    "native_inspection_tools": "existing-local-project",
    "sdk_dependency": false,
    "driver_install_or_execution": false
  }
}
