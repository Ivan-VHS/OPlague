export component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback activated();

    height: 42px;
    border-radius: 8px;
    background: active ? #E6F0FF : #F4F7FB;

    Text {
        x: 14px;
        y: 0px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: root.active ? #0052CC : #0A1F44;
        font-size: 14px;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

export component PrimaryAction inherits Rectangle {
    in property <string> label;
    callback activated();

    height: 42px;
    border-radius: 6px;
    background: #0052CC;

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: #FFFFFF;
        font-size: 14px;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

export component MainWindow inherits Window {
    title: "OPlague — DuckDriver Core";
    width: 1440px;
    height: 900px;
    min-width: 1100px;
    min-height: 720px;
    background: #FFFFFF;

    in-out property <string> current-page: "Обзор и пульс";
    in-out property <string> devices-summary: "Инвентаризация…";
    in-out property <string> status-message: "Подготовка локального адаптера…";
    callback scan-requested();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 64px;
            background: #FFFFFF;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                Text {
                    text: "●";
                    color: #E62E2D;
                    font-size: 28px;
                    vertical-alignment: center;
                }
                Text {
                    text: "OPlague";
                    color: #0052CC;
                    font-size: 23px;
                    vertical-alignment: center;
                }
                Text {
                    text: "DUCKDRIVER CORE";
                    color: #E62E2D;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: "LOCAL · READ ONLY";
                    color: #4A6085;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: #DCE5F2; }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 220px;
                background: #F4F7FB;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: "WORKSPACE"; color: #4A6085; font-size: 10px; }

                    NavButton {
                        label: "Обзор и пульс";
                        active: root.current-page == "Обзор и пульс";
                        activated => { root.current-page = "Обзор и пульс"; }
                    }
                    NavButton {
                        label: "Топология шин";
                        active: root.current-page == "Топология шин";
                        activated => { root.current-page = "Топология шин"; }
                    }
                    NavButton {
                        label: "Унификатор UDB";
                        active: root.current-page == "Унификатор UDB";
                        activated => { root.current-page = "Унификатор UDB"; }
                    }
                    NavButton {
                        label: "Пакеты драйверов";
                        active: root.current-page == "Пакеты драйверов";
                        activated => { root.current-page = "Пакеты драйверов"; }
                    }
                    NavButton {
                        label: "Лаборатория задержек";
                        active: root.current-page == "Лаборатория задержек";
                        activated => { root.current-page = "Лаборатория задержек"; }
                    }
                    NavButton {
                        label: "Time Duck";
                        active: root.current-page == "Time Duck";
                        activated => { root.current-page = "Time Duck"; }
                    }
                    NavButton {
                        label: "Диагностика";
                        active: root.current-page == "Диагностика";
                        activated => { root.current-page = "Диагностика"; }
                    }
                    NavButton {
                        label: "Профили";
                        active: root.current-page == "Профили";
                        activated => { root.current-page = "Профили"; }
                    }
                    NavButton {
                        label: "Журнал";
                        active: root.current-page == "Журнал";
                        activated => { root.current-page = "Журнал"; }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "TRI-COLOR DUCK UI"; color: #4A6085; font-size: 10px; }
                    Text { text: "Preview 0.1.0"; color: #4A6085; font-size: 11px; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #FFFFFF;
                VerticalLayout {
                    padding: 28px;
                    spacing: 18px;

                    Text {
                        text: root.current-page;
                        color: #0A1F44;
                        font-size: 28px;
                    }

                    if root.current-page == "Обзор и пульс": VerticalLayout {
                        spacing: 16px;

                        Rectangle {
                            height: 148px;
                            background: #F4F7FB;
                            border-width: 1px;
                            border-color: #DCE5F2;
                            border-radius: 12px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Text { text: "УТИНЫЙ РАДАР ЗДОРОВЬЯ"; color: #0052CC; font-size: 11px; }
                                Text { text: "Индекс здоровья пока не рассчитан"; color: #0A1F44; font-size: 23px; }
                                Text {
                                    text: "Оценка появится только после получения полного набора проверяемых данных.";
                                    color: #4A6085;
                                    font-size: 13px;
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 126px;
                            spacing: 14px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: #FFFFFF;
                                border-width: 1px;
                                border-color: #DCE5F2;
                                border-radius: 12px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "ОБОРУДОВАНИЕ"; color: #4A6085; font-size: 11px; }
                                    Text { text: root.devices-summary; color: #0A1F44; font-size: 18px; }
                                    Text { text: "PCI · USB · локальная инвентаризация"; color: #4A6085; font-size: 11px; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #FFFFFF;
                                border-width: 1px;
                                border-color: #DCE5F2;
                                border-radius: 12px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "DRIVER VAULT"; color: #4A6085; font-size: 11px; }
                                    Text { text: "Не подключён"; color: #0A1F44; font-size: 18px; }
                                    Text { text: "Каталог пакетов — следующий этап"; color: #4A6085; font-size: 11px; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #FFFFFF;
                                border-width: 1px;
                                border-color: #DCE5F2;
                                border-radius: 12px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "LATENCY LAB"; color: #4A6085; font-size: 11px; }
                                    Text { text: "Не подключена"; color: #0A1F44; font-size: 18px; }
                                    Text { text: "ETW и DPC/ISR — следующий этап"; color: #4A6085; font-size: 11px; }
                                }
                            }
                        }

                        Rectangle {
                            background: #FFFFFF;
                            border-width: 1px;
                            border-color: #DCE5F2;
                            border-radius: 12px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "ЛОКАЛЬНАЯ ИНВЕНТАРИЗАЦИЯ"; color: #0052CC; font-size: 11px; }
                                Text { text: root.status-message; color: #0A1F44; font-size: 13px; }
                                PrimaryAction {
                                    label: "Сканировать оборудование";
                                    width: 230px;
                                    activated => { root.scan-requested(); }
                                }
                            }
                        }

                        Rectangle {
                            height: 72px;
                            background: #FFF1F0;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 12px;
                                Text {
                                    text: "Безопасный режим: приложение только читает сведения об оборудовании. Установка, удаление и перенастройка драйверов пока не выполняются.";
                                    color: #0A1F44;
                                    font-size: 12px;
                                }
                            }
                        }
                    } else: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 130px;
                            background: #F4F7FB;
                            border-width: 1px;
                            border-color: #DCE5F2;
                            border-radius: 12px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Text { text: "МОДУЛЬ В СПЕЦИФИКАЦИИ"; color: #0052CC; font-size: 11px; }
                                Text { text: root.current-page; color: #0A1F44; font-size: 22px; }
                                Text {
                                    text: "Архитектурный контракт и критерии готовности опубликованы в docs/. Функциональный адаптер будет включён после реализации и тестирования.";
                                    color: #4A6085;
                                    font-size: 13px;
                                }
                            }
                        }
                        Text {
                            text: "Неподключённая возможность не имитирует данные и не выполняет системные изменения.";
                            color: #4A6085;
                            font-size: 13px;
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Rectangle { height: 1px; background: #DCE5F2; }
                    Text {
                        text: "OPlague · Native Desktop Hardware Orchestrator · Local-first";
                        color: #4A6085;
                        font-size: 11px;
                    }
                }
            }
        }
    }
}
