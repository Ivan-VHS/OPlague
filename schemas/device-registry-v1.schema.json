{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/OPlague/blob/main/schemas/device-registry-v1.schema.json",
  "title": "OPlague Device Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "revision", "updated_at", "devices", "packages", "snapshots"],
  "properties": {
    "schema": {"const": "oplage.device-registry"},
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "minLength": 1},
    "devices": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/record"}},
    "packages": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/record"}},
    "snapshots": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/snapshot"}}
  },
  "$defs": {
    "record": {"type": "object", "additionalProperties": true},
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "captured_at", "label", "devices", "packages", "metrics"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "captured_at": {"type": "string", "minLength": 1},
        "label": {"type": "string", "maxLength": 256},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "packages": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "metrics": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
